{
  "name": "mcp-context-processor",
  "version": "1.0.0",
  "description": "Linear + Git + MCP + Cursor를 이용한 컨텍스트 개발 파이프라인",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "trigger": "curl -X POST http://localhost:3008/trigger/FE-1140",
    "test:api": "curl http://localhost:3008/test/FE-1140"
  },
  "keywords": ["mcp", "linear", "git", "cursor", "automation"],
  "author": "김형민",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@octokit/rest": "^20.0.2",
    "express": "^4.18.2",
    "simple-git": "^3.20.0",
    "dotenv": "^16.3.1",
    "axios": "^1.6.0",
    "zod": "^3.22.4",
    "winston": "^3.11.0",
    "bull": "^4.12.0",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/express": "^4.17.20",
    "@types/jest": "^29.5.5",
    "typescript": "^5.2.2",
    "tsx": "^3.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.51.0",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "prettier": "^3.0.3"
  }
}
